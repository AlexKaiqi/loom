# Host secrets/state never belong in source or evidence.
.DS_Store
.env
.env.*
*.key
*.pem
*.clixml
.local/
.venv/
.venvs/
node_modules/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.runtime-env/
*.sqlite
*.sqlite3
*.db
