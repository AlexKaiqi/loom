{
  "protocol": 1,
  "events": {
    "work.objective.set": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "work.message": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  },
  "tools": [
    {
      "name": "bash",
      "capability": "tool.exec",
      "description": "Execute ordinary Bash. environment=work exposes /work/surface and /work/harness for file editing and $FACTS_DB for readonly SQLite queries. environment=sandbox runs in the named task target. No Loom-specific shell commands are needed.",
      "parameters": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "script": {
            "type": "string"
          },
          "timeout": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 120
          },
          "environment": {
            "type": "string",
            "enum": [
              "work",
              "sandbox"
            ]
          }
        },
        "required": [
          "environment",
          "script"
        ],
        "additionalProperties": false
      }
    }
  ]
}
