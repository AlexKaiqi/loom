  "finite_domain": {
    "scope": "每例独立初始化，只包含用例列明的有限身份和值；本模型不代表无限输入或任意故障。",
    "max_surfaces": 2,
    "max_waits": 1,
    "max_events": 2,
    "max_steps": 2,
    "max_request_identities": 2,
    "max_operation_identities": 3,
    "counter_domain": [
      0,
      1,
      2,
      "overflow"
    ],
    "time_domain": [
      "promise_active",
      "promise_expired"
    ],
    "opaque_tokens": "R1/M1/S1/W1/E1/I1/C1 等是固定独立内容/版本标签，不是由实现生成预期；恢复内容或授权不匹配时不得计入对应可解析集合。",
    "scheduler": {
      "fair": true,
      "max_enabled_transitions_per_settle": 8,
      "budget_is": "有限探索界限，非服务时限/SLA",
      "bound_exhausted": "INCONCLUSIVE_NOT_PASS",
      "fair_stall_or_cycle_with_accepted_work": "MODEL_FAIL",
      "note": "冻结前若抽象阶段合法需要更多步，应依模型结构修订界限并保留版本，不以未跑到目标就算成功。"
    },
    "supplement_tokens": {
      "decisions": [
        "d1"
      ],
      "payloads": [
        "continue:step2"
      ],
      "execution_identities": [
        "op2"
      ],
      "source_results": [
        "R1",
        "R2"
      ],
      "harness_versions": [
        "h1v1",
        "h1v2"
      ]
    }
  },
  "observer_defaults": {
