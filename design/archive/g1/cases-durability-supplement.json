  "observer_rules": {
    "state_is": "归一化观测视图，不规定生产存储字段；对任一实现的观察适配须事先定义且不能从 expected 复制。",
    "at": "aN 指该动作及其直接转移完成后的检查点；all 包含初始状态和每个动作后的状态。",
    "path": "点分对象路径。已声明 request/decision/registration/event_bindings 映射内不存在身份返回 null；未知字段路径为协议错误，不能静默返回 null。",
    "comparators": {
      "eq": "类型敏感相等",
      "ne": "类型敏感不相等",
      "contains": "数组含指定元素",
      "set_eq": "数组内容按集合相等；源数组重复身份是否允许由独立计数/关系约束另验"
    },
    "confirmed_refs": "观察器从 fixture 确认历史得到曾确认的内容身份，不由恢复器成功声明构造。",
    "resolvable_refs": "仅当对应权威 fixture 在当前授权/版本下能返回该固定原内容时包含该身份；仅有路径/摘要/ID 不够。",
    "recoverable_responsibility": "观察器检查存在持久依据覆盖当前未决决定或后续安排；不能由模型自由赋 true。",
    "counts": "logical_request_count 和 delivery_responsibility_count 从实际接受的不同逻辑身份/关系计数；external_effect_count/model_call_count 从独立环境轨迹计数，不从 Runtime 日志声称计数。",
    "runtime_reports": "request.caller_view、recovery_status、execution_status、completion_claim 是待对照实际环境的报告，不作为它们自身正确性的证据。",
    "case_success": "全部 expected 成立且轨迹没有未解析动作、界限耗尽或公平停滞；必须另跑 known_bad_variant 并观测至少一个 must_violate 项失败。",
    "mutation": "known_bad_variant 改变通用转移/观察来源，而不按 case ID 硬编码错误；不修改 expected。"
  },
  "action_semantics": {
    "accept_decision": "持久接受外部定义给出的决定身份、内容、源结果、版本及执行身份；一般解释代码不假定恒定。",
    "crash": "清除 args.domain 指定的易失进程/连接/缓存/沙箱；保留故障范围承诺持久的依赖事实。cut 为插入位置注释，不改变阶段转移规则。",
    "restart": "重新建立共享运行机制；不能凭启动本身伪造任务完成、模型结果或受理责任。",
    "settle_enabled_recovery": "公平驱动该用例已启用的恢复、外部解释、交付或启动转移，直到有限目标的稳定状态；不得按 case ID/expected 写状态。参见调度与界限规则。"
  },
  "preregistered_clarification": "accept_decision 的既有身份比较包括 payload、execution_id、source_result、harness_version 的已接受值；任何字段不同均冲突，保持原记录及责任；全部相同则复用。",
