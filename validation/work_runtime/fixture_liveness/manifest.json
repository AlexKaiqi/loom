{
  "schema": "loom.harness/v1",
  "entry": { "ref": "logic/main.py" },
  "facts": {
    "kinds": [
      { "kind": "sys.tool.result", "producer": "runtime", "contract": { "ref": "contracts/sys-tool-result.json" } },
      { "kind": "sys.tool.started", "producer": "runtime", "contract": { "ref": "contracts/sys-tool-started.json" } },
      { "kind": "sys.tool.check", "producer": "runtime", "contract": { "ref": "contracts/sys-tool-check.json" } },
      { "kind": "sys.tool.abandoned", "producer": "runtime", "contract": { "ref": "contracts/sys-tool-abandoned.json" } },
      { "kind": "sys.action.rejected", "producer": "runtime", "contract": { "ref": "contracts/sys-action-rejected.json" } },
      { "kind": "liveness.request", "producer": "external", "contract": { "ref": "contracts/liveness-request.json" } },
      { "kind": "liveness.done", "producer": "harness", "contract": { "ref": "contracts/liveness-done.json" } }
    ],
    "triggers": [
      { "id": "wake", "on": ["liveness.request"] }
    ]
  },
  "roles": {
    "rounds": [ { "id": "default", "ref": "rounds/main.py" } ],
    "projection": [ { "id": "default", "ref": "projection/main.py" } ],
    "logic": [ { "id": "default", "ref": "logic/main.py" } ],
    "admission": [ { "id": "default", "ref": "admission/main.py" } ]
  },
  "views": [],
  "extensions": []
}
