{
  "kind": "sys.tool.result",
  "producer": "runtime",
  "note": "Runtime observation of one shell execution. outcome is authoritative; exit is a compatibility mirror.",
  "payload": {
    "call_id": "string (<round_id>:<step>)",
    "script": "string",
    "target": "string",
    "cwd": "string or null",
    "exit": "integer",
    "outcome": "ok | failed | timeout | unknown",
    "side_effects": "none | possible | unknown",
    "duration_ms": "integer",
    "stdout_digest": "sha256 of the full stdout bytes",
    "stdout": "string (inline, bounded)",
    "stderr": "string (inline, bounded)"
  }
}
